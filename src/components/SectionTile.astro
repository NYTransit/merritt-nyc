---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  index: string;
  wide?: boolean;
}

const { title, description, href, image, alt, index, wide = false } = Astro.props;
const resolvedHref = withBase(href);
---

<article class:list={['section-tile', { 'section-tile--wide': wide }]}>
  <a href={resolvedHref} class="tile-link">
    <div class="tile-image-wrap">
      <Image
        src={image}
        alt={alt}
        widths={wide ? [640, 960, 1280, 1800] : [480, 720, 960]}
        sizes={wide ? '(max-width: 1180px) calc(100vw - 40px), 1100px' : '(max-width: 767px) calc(100vw - 40px), 535px'}
        format="webp"
        loading="lazy"
      />
      <span class="placeholder-label">Editorial placeholder</span>
    </div>
    <div class="tile-caption">
      <span class="tile-index" aria-hidden="true">{index}</span>
      <div>
        <h3>{title}<span aria-hidden="true">↗</span></h3>
        <p>{description}</p>
      </div>
    </div>
  </a>
</article>
