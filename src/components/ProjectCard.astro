---
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  category: string;
  year: number;
  status: string;
  index: number;
  href: string;
}

const { title, description, category, year, status, index, href } = Astro.props;
---

<article class="project-card">
  <div class="project-number" aria-hidden="true">{String(index).padStart(2, '0')}</div>
  <div class="project-copy">
    <div class="project-meta">
      <span>{category}</span>
      <span>{year}</span>
      <span>{status}</span>
    </div>
    <a class="project-link" href={withBase(href)}>
      <h2>{title}</h2>
      <p>{description}</p>
      <span class="project-destination">View section <span aria-hidden="true">→</span></span>
    </a>
  </div>
</article>
