---
import { navigation, site } from '../data/site';
import { withBase } from '../utils/paths';

const currentPath = Astro.url.pathname;
const homeHref = withBase('/');
const isActive = (href: string) =>
  href === homeHref ? currentPath === homeHref : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={homeHref} aria-label={`${site.name} home`}>{site.name}</a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {
          navigation.map((item) => {
            const href = withBase(item.href);
            return (
            <li>
              <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
