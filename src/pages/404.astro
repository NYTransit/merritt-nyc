---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | MERRITT.NYC"
  description="The requested page could not be found."
>
  <div class="page-shell error-page">
    <p class="error-code">404 / NOT FOUND</p>
    <h1>Nothing here. Yet.</h1>
    <p>
      The page may have moved, or perhaps it was one of those projects that took considerably
      longer than expected. <a class="quiet-link" href="/">Return home</a>.
    </p>
  </div>
</BaseLayout>
