---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const collection = [
  { date: '2026-10-01', name: 'Executor Super Star Destroyer', number: '75457', pieces: 6130, note: 'UCS' },
  { date: '2026-04-30', name: "The Mandalorian's N-1 Starfighter", number: '75442', pieces: 1809 },
  { date: '2025-08-21', name: 'Shuttle Carrier Aircraft', number: '10360', pieces: 2417 },
  { date: '2024-07-27', name: 'Notre-Dame de Paris', number: '21061', pieces: 4382 },
  { date: '2024-07-20', name: 'Mercedes-AMG F1 W14 E Performance', number: '42171', pieces: 1642 },
  { date: '2024-07-04', name: 'NASA Artemis Space Launch System', number: '10341', pieces: 3601 },
  { date: '2024-07-03', name: 'Red London Telephone Box', number: '21347', pieces: 1460 },
  { date: '2024-06-16', name: 'TIE Interceptor', number: '75382', pieces: 1931, note: 'UCS' },
  { date: '2024-04-22', name: 'Stitch', number: '43249', pieces: 730 },
  { date: '2024-01-08', name: 'NASA Apollo 11 Lunar Lander', number: '10266', pieces: 1087 },
  { date: '2023-12-19', name: 'New York City', number: '21028', pieces: 598 },
  { date: '2023-12-13', name: 'Natural History Museum', number: '10326', pieces: 4015 },
  { date: '2023-12-11', name: 'Alpine Lodge', number: '10325', pieces: 1517 },
  { date: '2023-12-08', name: 'NASA Mars Rover Perseverance', number: '42158', pieces: 1132 },
  { date: '2023-12-08', name: 'Snowtrooper Battle Pack', number: '75320', pieces: 105 },
  { date: '2023-12-08', name: 'Hoth AT-ST', number: '75322', pieces: 586 },
  { date: '2023-12-08', name: 'Disney Castle', number: '43222', pieces: 4837 },
  { date: '2023-12-08', name: 'The Razor Crest', number: '75331', pieces: 6187, note: 'UCS' },
  { date: '2023-12-08', name: 'Executor Super Star Destroyer', number: '75356', pieces: 630, note: 'Second copy' },
  { date: '2023-10-25', name: 'Imperial TIE Fighter', number: '75300', pieces: 432 },
  { date: '2023-09-23', name: 'AT-AP Walker', number: '75234', pieces: 689 },
  { date: '2023-09-23', name: 'Concorde', number: '10318', pieces: 2083 },
  { date: '2023-09-23', name: 'PEUGEOT 9X8 24H Le Mans Hybrid Hypercar', number: '42156', pieces: 1775 },
  { date: '2023-09-23', name: 'McLaren Formula 1 Race Car', number: '42141', pieces: 1432 },
  { date: '2023-09-23', name: '2022 Ford GT', number: '42154', pieces: 1466 },
  { date: '2023-09-23', name: 'Lamborghini Sián FKP 37', number: '42115', pieces: 3696 },
  { date: '2023-09-23', name: 'Bugatti Chiron', number: '42083', pieces: 3599 },
  { date: '2023-09-23', name: "Yoda's Jedi Starfighter", number: '75360', pieces: 253 },
  { date: '2023-09-23', name: 'X-Wing Starfighter', number: '75355', pieces: 1949, note: 'UCS' },
  { date: '2023-09-23', name: 'Ferrari Daytona SP3', number: '42143', pieces: 3778 },
  { date: '2023-09-23', name: 'Motorized Lighthouse', number: '21335', pieces: 2065 },
  { date: '2023-09-21', name: 'Police Station', number: '10278', pieces: 2923 },
  { date: '2022-12-06', name: 'NASA Space Shuttle Discovery', number: '10283', pieces: 2355 },
  { date: '2022-12-02', name: 'NASA Apollo Saturn V', number: '92176', pieces: 1969 },
  { date: '2022-12-02', name: 'Darth Vader Helmet', number: '75304', pieces: 834 },
  { date: '2022-11-06', name: 'Millennium Falcon', number: '75192', pieces: 7541, note: 'UCS' },
  { date: '2022-11-06', name: 'World Map', number: '31203', pieces: 11695 },
  { date: '2022-11-06', name: 'The Child (Grogu)', number: '75318', pieces: 1073 },
];

const years = [...new Set(collection.map((item) => item.date.slice(0, 4)))];
const yearPieceCounts = Object.fromEntries(
  years.map((year) => [
    year,
    collection.filter((item) => item.date.startsWith(year)).reduce((sum, item) => sum + item.pieces, 0),
  ]),
);
const totalPieces = collection.reduce((sum, item) => sum + item.pieces, 0);
type CollectionItem = (typeof collection)[number];
const imageOverrides: Record<string, string> = {
  '10318': 'https://images.brickset.com/sets/large/10318-1.jpg',
};
const imageUrl = (number: string) =>
  imageOverrides[number] ?? `https://cdn.rebrickable.com/media/sets/${number}-1.jpg`;
const productSlug = (name: string) =>
  name
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[’']/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
const legoUrl = (item: CollectionItem) =>
  `https://www.lego.com/en-us/product/${productSlug(item.name)}-${item.number}`;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="The LEGO Collection | MERRITT.NYC"
  description="Brian Merritt's LEGO collection: Star Wars UCS sets, NASA builds, Technic cars, architecture, and more."
>
  <div class="page-shell collection-page">
    <PageIntro
      eyebrow="The collection"
      title="Built, displayed, catalogued."
      subtitle="Starships, spacecraft, supercars, landmarks—and the occasional delightful oddity."
    />

    <figure class="editorial-figure editorial-feature collection-feature">
      <img
        src="https://live.staticflickr.com/4332/36462167393_a00ed1f54d_b.jpg"
        alt="LEGO Ultimate Collector Series Millennium Falcon set 75192 photographed after assembly"
        width="1024"
        height="576"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>
        Millennium Falcon · 75192. Temporary reference photo by
        <a href="https://www.flickr.com/photos/brickset/36462167393" rel="noreferrer">Brickset</a>,
        cropped · <a href="https://creativecommons.org/licenses/by/2.0/" rel="noreferrer">CC BY 2.0</a>.
      </figcaption>
    </figure>

    <section class="collection-overview" aria-labelledby="collection-overview-title">
      <div class="collection-overview-copy">
        <p class="eyebrow">The running count</p>
        <h2 id="collection-overview-title">
          A little bit of everything, with a definite pull to a galaxy far, far away.
        </h2>
        <p>
          It all started with building the World Map with my daughters, then flying off in the Falcon together.
          Now I’m undertaking the Executor Super Star Destroyer.
        </p>
      </div>
      <dl class="collection-stats" aria-label="Collection summary">
        <div>
          <dt>Set count</dt>
          <dd>{collection.length}</dd>
        </div>
        <div>
          <dt>Piece count</dt>
          <dd class="collection-stat-pieces">{totalPieces.toLocaleString('en-US')}</dd>
        </div>
        <div>
          <dt>Hours of fun</dt>
          <dd class="collection-stat-infinity" aria-label="Unlimited">∞</dd>
        </div>
      </dl>
    </section>

    <section class="collection-gallery" aria-labelledby="collection-gallery-title">
      <div class="section-heading-row collection-heading-row">
        <div>
          <p class="eyebrow">A closer look</p>
          <h2 class="section-heading" id="collection-gallery-title">Big ideas, brick by brick.</h2>
        </div>
        <p class="section-note">Reference photography · Personal photos coming later</p>
      </div>

      <div class="collection-gallery-grid">
        <figure class="editorial-figure collection-gallery-item">
          <img
            src="https://live.staticflickr.com/4191/34429768012_d06d8d6945_b.jpg"
            alt="Close-up of the LEGO NASA Apollo Saturn V rocket engines with an astronaut minifigure for scale"
            width="1024"
            height="685"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <strong>NASA Apollo Saturn V</strong>
            The original 21309 edition; Brian's collection includes its 92176 reissue. Photo by
            <a href="https://www.flickr.com/photos/brickset/34429768012" rel="noreferrer">Brickset</a>,
            cropped · <a href="https://creativecommons.org/licenses/by/2.0/" rel="noreferrer">CC BY 2.0</a>.
          </figcaption>
        </figure>

        <figure class="editorial-figure collection-gallery-item">
          <img
            src="https://live.staticflickr.com/65535/49973005011_2f53182b32_b.jpg"
            alt="Close-up of the V12 engine inside the LEGO Technic Lamborghini Sián FKP 37"
            width="1024"
            height="768"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <strong>Lamborghini Sián FKP 37 · 42115</strong>
            Photo by <a href="https://www.flickr.com/photos/brickset/49973005011" rel="noreferrer">Brickset</a>,
            cropped · <a href="https://creativecommons.org/licenses/by/2.0/" rel="noreferrer">CC BY 2.0</a>.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="collection-catalog" aria-labelledby="collection-catalog-title">
      <div class="section-heading-row collection-heading-row">
        <div>
          <p class="eyebrow">Acquisition log</p>
          <h2 class="section-heading" id="collection-catalog-title">The complete catalog</h2>
        </div>
        <p class="section-note">
          Newest first · Reference thumbnails via
          <a href="https://rebrickable.com/" rel="noreferrer">Rebrickable</a> and
          <a href="https://brickset.com/" rel="noreferrer">Brickset</a>
        </p>
      </div>

      {years.map((year) => (
        <section class="collection-year" aria-labelledby={`year-${year}`}>
          <div class="collection-year-heading">
            <h3 id={`year-${year}`}>{year}</h3>
            <span>{yearPieceCounts[year].toLocaleString('en-US')} pieces</span>
          </div>
          <ol class="collection-list">
            {collection
              .filter((item) => item.date.startsWith(year))
              .map((item) => (
                <li class="collection-item">
                  <a class="collection-item-link" href={legoUrl(item)}>
                    <span class="collection-item-thumb" aria-hidden="true">
                      <img
                        src={imageUrl(item.number)}
                        alt=""
                        width="160"
                        height="120"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <time datetime={item.date}>{dateFormatter.format(new Date(`${item.date}T00:00:00Z`))}</time>
                    <div class="collection-item-name">
                      <strong>{item.name}</strong>
                      <div class="collection-tags">
                        {item.note && <span>{item.note}</span>}
                        <span>{item.pieces.toLocaleString('en-US')} pieces</span>
                      </div>
                    </div>
                    <span class="collection-set-number">#{item.number} <span aria-hidden="true">↗</span></span>
                  </a>
                </li>
              ))}
          </ol>
        </section>
      ))}
    </section>
  </div>
</BaseLayout>
