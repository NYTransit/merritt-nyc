---
import { getImage } from 'astro:assets';
import heroImage from '../assets/images/hero-nyc-placeholder.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import '../styles/global.css';
import { withBase, withoutBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
} = Astro.props;

const canonical = new URL(withoutBase(Astro.url.pathname), site.url);
const socialImage = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 82,
});
const socialImageUrl = new URL(withoutBase(socialImage.src), site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FAF9F6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="A black-and-white tree-lined Manhattan street" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
